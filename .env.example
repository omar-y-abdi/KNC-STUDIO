# SECURITY: every VITE_*-prefixed variable is INLINED into the public client bundle by Vite.
# Never put a secret here. Secrets belong only in `.env.local` (git-ignored) or the host's env
# dashboard, and must NOT use the VITE_ prefix. This file holds public config only.

# Public site origin — used for canonical / Open Graph / sitemap URLs. No trailing slash.
VITE_SITE_URL=https://knc-studio.vercel.app

# Booking date source:
#   real  -> production: calendar uses the real current day
#   fixed -> visual-regression baseline: pins 2026-06-19 so the calendar matches the original mock
VITE_CLOCK=real

# Supabase backend. Leave BOTH BLANK to use the offline mock adapters (the default — the site runs
# fully, nothing is persisted). Set BOTH (Supabase project -> Settings -> API) to switch the live
# site to the real backend (bookings/reviews/cancellation persist; availability is DB-driven).
# The anon key is PUBLIC and safe to inline here — RLS + SECURITY DEFINER RPCs are the boundary.
# The service_role key is SECRET: never put it here, never give it a VITE_ prefix (it would be
# bundled into the public client). It belongs only in server env / `.env.local` (git-ignored).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
