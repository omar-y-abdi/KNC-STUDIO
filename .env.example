# SECURITY: every VITE_*-prefixed variable is INLINED into the public client bundle by Vite.
# Never put a secret here. Secrets belong only in `.env.local` (git-ignored) or the host's env
# dashboard, and must NOT use the VITE_ prefix. This file holds public config only.

# Public site origin — used for canonical / Open Graph / sitemap URLs. No trailing slash.
VITE_SITE_URL=https://knc-studio.vercel.app

# Booking date source:
#   real  -> production: calendar uses the real current day
#   fixed -> visual-regression baseline: pins 2026-06-19 so the calendar matches the original mock
VITE_CLOCK=real
