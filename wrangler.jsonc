{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "bladeblendstudio",
  "main": "./supabase/worker/index.ts",
  "compatibility_date": "2026-08-09",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "bladeblendstudio.se",
      "custom_domain": true,
    },
    {
      "pattern": "www.bladeblendstudio.se",
      "custom_domain": true,
    },
  ],
  "observability": {
    "enabled": true,
  },
  "cache": {
    "enabled": false,
  },
  "exports": {
    "default": {
      "type": "worker",
      "cache": { "enabled": false },
    },
    "PublicContent": {
      "type": "worker",
      "cache": { "enabled": true },
    },
  },
  "vars": {
    "SUPABASE_URL": "https://soktgawvexeumqvtyhda.supabase.co",
    // Maintenance switch. To close the site, change "off" to "on" and deploy the Worker: every
    // request it receives then answers 503 with public/maintenance.html (JSON under /api/). To
    // open it again, change back to "off" and deploy. Any value other than "on" leaves it open.
    "MAINTENANCE": "off",
  },
  // Counts the requests to /api/customer-bookings for each client address and action, an IPv6
  // address by the /64 it is in: at most "limit" of them in "period" seconds, then 429 until the
  // period has passed. The period is also GATEWAY_RATE_LIMIT_PERIOD_SECONDS in
  // supabase/worker/customerGateway.ts.
  "ratelimits": [
    {
      "name": "GATEWAY_RATE_LIMIT",
      "namespace_id": "1001",
      "simple": { "limit": 60, "period": 60 },
    },
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "none",
    "html_handling": "none",
    "run_worker_first": [
      "/*",
      "!/assets/*",
      "!/fonts/*",
      "!/icons/*",
      "!/favicon.svg",
      "!/favicon.ico",
      "!/apple-touch-icon.png",
      "!/site.webmanifest",
      "!/icons.svg",
      "!/info.css",
      "!/tokens.css",
      "!/og-image.png",
      "!/robots.txt",
      "!/googlefbf0c3168fbf0af5.html",
    ],
  },
}
