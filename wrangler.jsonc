{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "bladeblendstudio",
  "compatibility_date": "2026-08-09",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "bladeblendstudio.se",
      "custom_domain": true,
    },
    {
      "pattern": "www.bladeblendstudio.se",
      "custom_domain": true,
    },
  ],
  "observability": {
    "enabled": true,
  },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "html_handling": "drop-trailing-slash",
  },
}
