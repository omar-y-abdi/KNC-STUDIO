{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "bladeblendstudio",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-08-09",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "bladeblendstudio.se",
      "custom_domain": true,
    },
    {
      "pattern": "www.bladeblendstudio.se",
      "custom_domain": true,
    },
  ],
  "observability": {
    "enabled": true,
  },
  "cache": {
    "enabled": true,
  },
  "vars": {
    "SUPABASE_URL": "https://soktgawvexeumqvtyhda.supabase.co",
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "none",
    "html_handling": "none",
    "run_worker_first": [
      "/*",
      "!/assets/*",
      "!/fonts/*",
      "!/icons/*",
      "!/.well-known/*",
      "!/favicon.svg",
      "!/icons.svg",
      "!/og-image.png",
      "!/robots.txt",
      "!/sitemap.xml",
      "!/googlefbf0c3168fbf0af5.html",
    ],
  },
}
