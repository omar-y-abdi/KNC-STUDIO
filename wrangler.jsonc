{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "bladeblendstudio",
  "main": "./supabase/worker/index.ts",
  "compatibility_date": "2026-08-09",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "bladeblendstudio.se",
      "custom_domain": true,
    },
    {
      "pattern": "www.bladeblendstudio.se",
      "custom_domain": true,
    },
  ],
  "observability": {
    "enabled": true,
  },
  "cache": {
    "enabled": false,
  },
  "exports": {
    "default": {
      "type": "worker",
      "cache": { "enabled": false },
    },
    "PublicContent": {
      "type": "worker",
      "cache": { "enabled": true },
    },
  },
  "vars": {
    "SUPABASE_URL": "https://soktgawvexeumqvtyhda.supabase.co",
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "none",
    "html_handling": "none",
    "run_worker_first": [
      "/*",
      "!/assets/*",
      "!/fonts/*",
      "!/icons/*",
      "!/favicon.svg",
      "!/favicon.ico",
      "!/apple-touch-icon.png",
      "!/site.webmanifest",
      "!/icons.svg",
      "!/info.css",
      "!/tokens.css",
      "!/og-image.png",
      "!/robots.txt",
      "!/googlefbf0c3168fbf0af5.html",
    ],
  },
}
